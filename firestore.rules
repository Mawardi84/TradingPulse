rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- VALIDATION BLUEPRINTS ---
    function isValidProfile(data) {
      return data.keys().hasAll(['email', 'updatedAt']) &&
             data.email is string && data.email.size() <= 100 &&
             (data.balance == null || data.balance is number) &&
             (data.displayName == null || data.displayName is string) &&
             (data.photoURL == null || data.photoURL is string);
    }

    function isValidWatchlist(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'symbols', 'updatedAt']) &&
             data.userId == userId &&
             data.name is string &&
             data.symbols is list;
    }

    function isValidPosition(data, userId) {
      return data.keys().hasAll(['userId', 'symbol', 'type', 'volume', 'entryPrice', 'status', 'updatedAt']) &&
             data.userId == userId &&
             data.symbol is string &&
             data.type in ['BUY', 'SELL'] &&
             data.status in ['OPEN', 'CLOSED'];
    }

    function isValidSettings(data, userId) {
      return data.keys().hasAll(['userId', 'updatedAt']) &&
             data.userId == userId &&
             (data.layoutConfig == null || data.layoutConfig is string) &&
             (data.theme == null || data.theme is string);
    }

    function isValidScript(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'code', 'language', 'updatedAt']) &&
             data.userId == userId &&
             data.name is string &&
             data.code is string;
    }

    // --- COLLECTION RULES ---

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProfile(incoming()) &&
                      incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidProfile(incoming()) &&
                      incoming().updatedAt == request.time;

      // 2. Watchlists (Sub-collection)
      match /watchlists/{watchlistId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWatchlist(incoming(), userId) &&
                        incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidWatchlist(incoming(), userId) &&
                        incoming().updatedAt == request.time;
        allow delete: if isOwner(userId);
      }

      // 3. Active Positions (Sub-collection)
      match /positions/{positionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPosition(incoming(), userId) &&
                        incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidPosition(incoming(), userId) &&
                        incoming().updatedAt == request.time;
        allow delete: if isOwner(userId);
      }

      // 4. Trade History (Sub-collection)
      match /history/{tradeId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPosition(incoming(), userId) &&
                        incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if false; // History is immutable
        allow delete: if isOwner(userId);
      }

      // 5. User Settings
      match /settings/terminal {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSettings(incoming(), userId) &&
                        incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidSettings(incoming(), userId) &&
                        incoming().updatedAt == request.time;
      }

      // 6. Quant Scripts (Sub-collection)
      match /scripts/{scriptId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidScript(incoming(), userId) &&
                        incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidScript(incoming(), userId) &&
                        incoming().updatedAt == request.time;
        allow delete: if isOwner(userId);
      }
    }
  }
}
