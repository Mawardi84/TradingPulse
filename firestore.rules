rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- VALIDATION BLUEPRINTS ---
    // --- VALIDATION BLUEPRINTS ---
    function isValidProfile(data) {
      return (data.email == null || data.email is string) &&
             (data.balance == null || data.balance is number) &&
             (data.displayName == null || data.displayName is string) &&
             (data.photoURL == null || data.photoURL is string);
    }

    function isValidWatchlist(data) {
      return (data.name == null || data.name is string) &&
             (data.symbols == null || data.symbols is list);
    }

    function isValidPosition(data) {
      return (data.symbol == null || data.symbol is string) &&
             (data.type == null || data.type in ['BUY', 'SELL']) &&
             (data.status == null || data.status in ['OPEN', 'CLOSED']);
    }

    function isValidSettings(data) {
      return (data.layoutConfig == null || data.layoutConfig is string) &&
             (data.theme == null || data.theme is string) &&
             (data.userId == null || data.userId is string) &&
             (data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidScript(data) {
      return (data.name == null || data.name is string) &&
             (data.code == null || data.code is string);
    }

    // --- COLLECTION RULES ---

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidProfile(incoming()) && incoming().email != null &&
                      incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidProfile(incoming()) &&
                      incoming().updatedAt == request.time;

      // 2. Watchlists (Sub-collection)
      match /watchlists/{watchlistId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWatchlist(incoming()) && incoming().userId == userId && incoming().name != null &&
                        incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidWatchlist(incoming()) &&
                        incoming().updatedAt == request.time;
        allow delete: if isOwner(userId);
      }

      // 3. Active Positions (Sub-collection)
      match /positions/{positionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPosition(incoming()) && incoming().userId == userId && incoming().symbol != null &&
                        incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidPosition(incoming()) &&
                        incoming().updatedAt == request.time;
        allow delete: if isOwner(userId);
      }

      // 4. Trade History (Sub-collection)
      match /history/{tradeId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPosition(incoming()) && incoming().userId == userId && incoming().symbol != null &&
                        incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if false; // History is immutable
        allow delete: if isOwner(userId);
      }

      // 5. User Settings
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // 6. Quant Scripts (Sub-collection)
      match /scripts/{scriptId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidScript(incoming()) && incoming().userId == userId && incoming().name != null &&
                        incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidScript(incoming()) &&
                        incoming().updatedAt == request.time;
        allow delete: if isOwner(userId);
      }
    }
  }
}
